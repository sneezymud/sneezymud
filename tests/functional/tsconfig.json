{
  // Every strict flag that's rational for an async telnet test harness.
  // Non-obvious flags:
  //   erasableSyntaxOnly - prevents enum/namespace/parameter properties that
  //     silently break under Bun's type-stripping execution model
  //   noUncheckedIndexedAccess - forces T | undefined on index access,
  //     critical for parsing telnet byte buffers and string splitting
  //   exactOptionalPropertyTypes - prevents { field: undefined } from
  //     satisfying { field?: string }
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noErrorTruncation": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["bun-types"],
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts"]
}
