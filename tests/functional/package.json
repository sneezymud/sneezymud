{
  "name": "sneezymud-functional-tests",
  "private": true,
  "scripts": {
    "test": "bun test",
    "test:smoke": "bun test tests/smoke.test.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "typecheck": "tsc",
    "check": "bun run typecheck && bun run lint && bun run format",
    "check:fix": "bun run typecheck && bun run lint:fix && bun run format:write"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.6.0",
    "@eslint/js": "^9",
    "@types/bun": "^1.3.9",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jest": "^29.14.0",
    "eslint-plugin-perfectionist": "^5.5.0",
    "eslint-plugin-regexp": "^3.0.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  }
}
